# Copy to `.env` and set values. Only ONE pair of API + WS URLs should be uncommented.

# --- Production ---
# EXPO_PUBLIC_API_BASE_URL=https://api.vajraev.com
# EXPO_PUBLIC_WS_BASE_URL=wss://api.vajraev.com

# --- Local Vajrabackend (same machine: use localhost; Android emulator often needs http://10.0.2.2:8080) ---
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_WS_BASE_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
